generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  sku       String   @db.VarChar(20)
  filename  String   @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sku])
  @@map("product_images")
}

model ProductDescription {
  id          Int      @id @default(autoincrement())
  sku         String   @unique @db.VarChar(7)
  description String   @db.Text
  updatedAt   DateTime @updatedAt

  @@map("product_descriptions")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(50)
  value String @db.Text

  @@map("settings")
}

model HiddenCategory {
  id         Int    @id @default(autoincrement())
  categoryId String @unique @db.VarChar(4)

  @@map("hidden_categories")
}

model FeaturedBrand {
  id      Int    @id @default(autoincrement())
  brandId String @unique @db.VarChar(4)

  @@map("featured_brands")
}

model PriceSnapshot {
  id       Int      @id @default(autoincrement())
  sku      String   @db.VarChar(7)
  precio   Decimal  @db.Decimal(12, 2)
  precio2  Decimal  @db.Decimal(12, 2)
  precio4  Decimal  @db.Decimal(12, 2)
  takenAt  DateTime @default(now())

  @@unique([sku])
  @@map("price_snapshots")
}

model PriceChange {
  id          Int      @id @default(autoincrement())
  sku         String   @db.VarChar(7)
  name        String   @db.VarChar(255)
  field       String   @db.VarChar(20)
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  detectedAt  DateTime @default(now())

  @@index([detectedAt])
  @@index([sku])
  @@map("price_changes")
}

model Combo {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  description String?     @db.Text
  price       Decimal?    @db.Decimal(12, 2)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  items       ComboItem[]

  @@map("combos")
}

model ComboItem {
  id       Int    @id @default(autoincrement())
  comboId  Int
  sku      String @db.VarChar(7)
  quantity Int    @default(1)
  combo    Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@map("combo_items")
}

model ArchivedOrder {
  id          Int      @id @default(autoincrement())
  boleta      String   @db.VarChar(9)
  nroped      String   @db.VarChar(8)
  fechora     String   @db.VarChar(14)
  clienteCod  String   @db.VarChar(7)
  clienteName String   @db.VarChar(60)
  totalCant   Decimal  @db.Decimal(12, 3)
  total       Decimal  @db.Decimal(12, 2)
  notas       String?  @db.Text
  archivedAt  DateTime @default(now())

  items       ArchivedOrderItem[]

  @@index([clienteCod])
  @@index([fechora])
  @@map("archived_orders")
}

model ArchivedOrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  sku         String @db.VarChar(7)
  productName String @db.VarChar(60)
  cant        Decimal @db.Decimal(12, 3)
  precio      Decimal @db.Decimal(12, 2)
  impo        Decimal @db.Decimal(12, 2)
  listaPrecio Int

  order       ArchivedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("archived_order_items")
}

model ClientDeliveryDay {
  id        Int    @id @default(autoincrement())
  clientId  String @db.VarChar(7)
  day       String @db.VarChar(20)

  @@unique([clientId, day])
  @@index([clientId])
  @@map("client_delivery_days")
}

// Delivery status tracking — per client per delivery date
model DeliveryStatus {
  id           Int      @id @default(autoincrement())
  clientId     String   @db.VarChar(7)
  fecha        DateTime @db.Date // delivery date
  estado       String   @db.VarChar(20) // "entregado" | "reintentar" | "rechazado" | "parcial"
  observaciones String? @db.Text
  deliveredBy  String?  @db.VarChar(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, fecha])
  @@index([fecha])
  @@map("delivery_status")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @db.VarChar(255)
  role         String   @default("staff") @db.VarChar(20)
  permissions  String   @default("[]") @db.Text
  empleadoCod  String?  @db.VarChar(7)
  email        String?  @db.VarChar(100)
  createdAt    DateTime @default(now())

  @@map("users")
}

model StockEntry {
  id            Int      @id @default(autoincrement())
  tipo          String   @default("ingreso") @db.VarChar(20)
  proveedorCod  String   @db.VarChar(7)
  proveedorName String   @db.VarChar(60)
  usuario       String   @db.VarChar(50)
  estado        String   @default("pendiente") @db.VarChar(20)
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  iva           Decimal  @default(0) @db.Decimal(12, 2)
  iibb          Decimal  @default(0) @db.Decimal(12, 2)
  percepciones  Decimal  @default(0) @db.Decimal(12, 2)
  descuento     Decimal  @default(0) @db.Decimal(12, 2)
  descuentoBase String   @default("neto") @db.VarChar(10)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  notas         String?  @db.Text
  nroFactura    String?  @db.VarChar(30)
  facturaImage  String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         StockEntryItem[]

  @@index([estado])
  @@index([createdAt])
  @@map("stock_entries")
}

model StockEntryItem {
  id          Int      @id @default(autoincrement())
  entryId     Int
  sku         String   @db.VarChar(7)
  productName String   @db.VarChar(60)
  cantidad    Decimal  @db.Decimal(12, 3)
  costo       Decimal? @db.Decimal(12, 2)
  costeado    Boolean  @default(false)
  isNewProduct Boolean @default(false)
  entry       StockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("stock_entry_items")
}

model SupplierPayment {
  id            Int      @id @default(autoincrement())
  proveedorCod  String   @db.VarChar(7)
  proveedorName String   @db.VarChar(60)
  monto         Decimal  @db.Decimal(12, 2)
  concepto      String?  @db.VarChar(100)
  usuario       String   @db.VarChar(50)
  createdAt     DateTime @default(now())

  @@index([proveedorCod])
  @@index([createdAt])
  @@map("supplier_payments")
}

model PriceMargin {
  id     Int     @id @default(autoincrement())
  lista  Int     @unique
  margen Decimal @db.Decimal(6, 2)

  @@map("price_margins")
}

model VendedorComision {
  id          Int      @id @default(autoincrement())
  vendedorCod String   @db.VarChar(7)
  rubroCod    String   @db.VarChar(4)
  porcentaje  Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendedorCod, rubroCod])
  @@index([vendedorCod])
  @@map("vendedor_comisiones")
}

model ArticuloPromocional {
  id        Int      @id @default(autoincrement())
  sku       String   @unique @db.VarChar(7)
  createdAt DateTime @default(now())

  @@map("articulos_promocionales")
}

model VendedorOrder {
  id           Int      @id @default(autoincrement())
  vendedorCod  String   @db.VarChar(7)
  vendedorName String   @db.VarChar(60)
  clienteCod   String   @db.VarChar(7)
  clienteName  String   @db.VarChar(60)
  total        Decimal  @db.Decimal(14, 2)
  comisionTotal Decimal @default(0) @db.Decimal(14, 2)
  estado       String   @default("pendiente") @db.VarChar(20)
  puntouchCod  String?  @db.VarChar(9)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  notas        String?  @db.Text
  createdAt    DateTime @default(now())
  items        VendedorOrderItem[]

  @@index([vendedorCod])
  @@index([clienteCod])
  @@index([createdAt])
  @@map("vendedor_orders")
}

model VendedorOrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  sku             String   @db.VarChar(7)
  productName     String   @db.VarChar(60)
  rubroCod        String?  @db.VarChar(4)
  cantidad        Decimal  @db.Decimal(12, 3)
  precioMayorista Decimal  @db.Decimal(12, 2)
  precioVenta     Decimal  @db.Decimal(12, 2)
  comisionPorc    Decimal  @default(0) @db.Decimal(5, 2)
  comisionMonto   Decimal  @default(0) @db.Decimal(12, 2)
  esPromocional   Boolean  @default(false)
  order           VendedorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("vendedor_order_items")
}

model InternalMovement {
  id          Int      @id @default(autoincrement())
  sucursal    String   @db.VarChar(50)
  destino     String   @db.VarChar(50)
  subtipo     String?  @db.VarChar(30)
  empleados   String?  @db.Text
  usuario     String   @db.VarChar(50)
  estado      String   @default("pendiente") @db.VarChar(20)
  notas       String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  aprobadoPor String?  @db.VarChar(50)
  aprobadoAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       InternalMovementItem[]

  @@index([estado])
  @@index([createdAt])
  @@map("internal_movements")
}

model InternalMovementItem {
  id          Int      @id @default(autoincrement())
  movementId  Int
  sku         String   @db.VarChar(7)
  productName String   @db.VarChar(60)
  cantidad    Decimal  @db.Decimal(12, 3)
  costo       Decimal? @db.Decimal(12, 2)
  movement    InternalMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([movementId])
  @@map("internal_movement_items")
}

model PeyaMapping {
  id           Int      @id @default(autoincrement())
  peyaSku      String   @unique @db.VarChar(50)
  puntouchSku  String   @db.VarChar(20)
  multiplier   Decimal  @default(1.0) @db.Decimal(6, 3)
  createdAt    DateTime @default(now())

  @@index([puntouchSku])
  @@map("peya_mappings")
}

model CierreCaja {
  id          Int      @id @default(autoincrement())
  sucursal    String   @db.VarChar(5)
  usuario     String   @db.VarChar(50)
  desde       String   @db.VarChar(20)
  cantVentas  Int
  efectivo    Decimal  @db.Decimal(14, 2)
  tarjeta     Decimal  @db.Decimal(14, 2)
  deuda       Decimal  @db.Decimal(14, 2)
  totalVentas Decimal  @db.Decimal(14, 2)
  retiros     Decimal  @db.Decimal(14, 2)
  ingresos    Decimal  @db.Decimal(14, 2)
  pagos       Decimal  @db.Decimal(14, 2)
  inicioCaja  Decimal  @db.Decimal(14, 2)
  totalCaja   Decimal  @db.Decimal(14, 2)
  nuevoInicio  Decimal  @default(0) @db.Decimal(14, 2)
  diferencia   Decimal  @default(0) @db.Decimal(14, 2)
  responsable  String   @default("") @db.VarChar(60)
  emailSent    Boolean  @default(false)
  emailTo      String?  @db.VarChar(255)
  chargedAt    DateTime?
  chargedBy    String?  @db.VarChar(60)
  createdAt    DateTime @default(now())

  @@index([sucursal])
  @@index([createdAt])
  @@index([responsable])
  @@map("cierres_caja")
}

model WhatsAppChat {
  id          Int      @id @default(autoincrement())
  chatId      String   @unique @db.VarChar(50)
  contactName String   @default("") @db.VarChar(100)
  contactPhone String  @default("") @db.VarChar(20)
  lastMessage String   @default("") @db.Text
  lastMessageAt DateTime @default(now())
  unread      Int      @default(0)
  messages    WhatsAppMessage[]

  @@index([lastMessageAt])
  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id        Int      @id @default(autoincrement())
  chatId    String   @db.VarChar(50)
  direction String   @db.VarChar(3) // "in" or "out"
  body      String   @db.Text
  sender    String   @default("") @db.VarChar(50) // "bot", "human", or contact name
  mediaType String?  @db.VarChar(20)
  timestamp DateTime @default(now())
  chat      WhatsAppChat @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@index([chatId, timestamp])
  @@map("whatsapp_messages")
}

// Log of proactive notifications sent to clients (debt reminders, reactivation, etc.)
// Audit log for price/cost changes
model PriceAudit {
  id        Int      @id @default(autoincrement())
  sku       String   @db.VarChar(10)
  nombre    String   @db.VarChar(100)
  campo     String   @db.VarChar(20) // "costo", "precio", "precio2", etc.
  valorAnterior Decimal @db.Decimal(14, 2)
  valorNuevo    Decimal @db.Decimal(14, 2)
  origen    String   @db.VarChar(30) // "precios", "costeo", "masivos"
  usuario   String   @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([sku])
  @@index([createdAt])
  @@map("price_audit")
}

// Backup of PunTouch pedidos (in case someone deletes them)
model PedidoBackup {
  id          Int       @id @default(autoincrement())
  boleta      String    @unique @db.VarChar(20)
  clienteCod  String    @db.VarChar(20)
  clienteName String    @db.VarChar(120)
  total       Decimal   @db.Decimal(14, 2)
  fechora     String    @db.VarChar(20)
  nroped      String?   @db.VarChar(20)
  items       String    @db.Text // JSON array of items
  active      Boolean   @default(true) // false = deleted from PunTouch
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
  @@index([clienteCod])
  @@map("pedido_backups")
}

// Print queue for automatic silent printing
model PrintJob {
  id        Int      @id @default(autoincrement())
  tipo      String   @db.VarChar(30) // "cierre" | etc.
  filename  String   @db.VarChar(255)
  pdfBase64 String   @db.Text
  sucursal  String?  @db.VarChar(10)
  printed   Boolean  @default(false)
  printedAt DateTime?
  createdAt DateTime @default(now())

  @@index([printed])
  @@index([createdAt])
  @@map("print_jobs")
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  clientId  String   @db.VarChar(20)
  tipo      String   @db.VarChar(30) // "deuda" | "reactivacion" | etc.
  mensaje   String   @db.Text
  telefono  String?  @db.VarChar(20)
  enviadoPor String? @db.VarChar(60)
  ok        Boolean  @default(true)
  error     String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([tipo])
  @@index([createdAt])
  @@map("notification_log")
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  shortcut  String   @unique @db.VarChar(30)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}

// Extra data for clients registered by vendedores (photos, GPS, WhatsApp)
model ClienteRegistro {
  id           Int      @id @default(autoincrement())
  clienteCod   String   @unique @db.VarChar(7)
  whatsapp     String?  @db.VarChar(20)
  fotoLocal    String?  @db.VarChar(500)
  fotoCuit     String?  @db.VarChar(500)
  lat          Float?
  lng          Float?
  registradoPor String? @db.VarChar(60)
  createdAt    DateTime @default(now())

  @@map("cliente_registros")
}

// Fichador — employee time tracking from biometric clock
model FichadorEmpleado {
  id          Int      @id @default(autoincrement())
  legajoId    Int      @unique
  nombre      String   @db.VarChar(100)
  area        String?  @db.VarChar(60)
  turno       String?  @db.VarChar(60)
  empleadoCod String?  @db.VarChar(7) // Link to PunTouch Empleados
  horasExtras Boolean  @default(true)
  tipoTurno   String   @default("fijo") @db.VarChar(10) // fijo, rotativo, cortado
  activo      Boolean  @default(true)
  horasTurno  Int      @default(9) // hours per shift (8 or 9)
  turnoInicio String   @default("09:00") @db.VarChar(5)
  turnoFin    String   @default("18:00") @db.VarChar(5)
  createdAt   DateTime @default(now())
  punches     FichadorPunch[]

  @@map("fichador_empleados")
}

model FichadorPunch {
  id          Int      @id @default(autoincrement())
  empleadoId  Int
  fecha       DateTime @db.Date
  hora        String   @db.VarChar(8) // HH:MM:SS
  tipo        String   @db.VarChar(10) // Entrada / Salida
  empleado    FichadorEmpleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@unique([empleadoId, fecha, hora])
  @@index([empleadoId])
  @@index([fecha])
  @@map("fichador_punches")
}

// Payroll config per employee
model EmpleadoSueldo {
  id            Int      @id @default(autoincrement())
  empleadoCod   String   @unique @db.VarChar(7)
  basico        Decimal  @default(0) @db.Decimal(14, 2)
  presentismo   Decimal  @default(0) @db.Decimal(14, 2)
  adicionalCaja Decimal  @default(0) @db.Decimal(14, 2)
  bono          Decimal  @default(0) @db.Decimal(14, 2)
  viatico       Decimal  @default(0) @db.Decimal(14, 2)
  plus          Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt

  @@map("empleado_sueldos")
}

// Monthly payroll adjustments (transfers, bonos extras, etc)
model LiquidacionAjuste {
  id          Int      @id @default(autoincrement())
  empleadoCod String   @db.VarChar(7)
  mes         String   @db.VarChar(7) // YYYY-MM
  concepto    String   @db.VarChar(60)
  monto       Decimal  @db.Decimal(14, 2) // positive = add, negative = deduct
  createdAt   DateTime @default(now())

  @@index([empleadoCod, mes])
  @@map("liquidacion_ajustes")
}

// Cuentas propias (bancos x CUITs)
model CuentaBancaria {
  id       Int      @id @default(autoincrement())
  banco    String   @db.VarChar(60)
  cuit     String   @db.VarChar(15)
  alias    String   @db.VarChar(60) // nombre corto visible
  activa   Boolean  @default(true)
  createdAt DateTime @default(now())
  cheques  Cheque[]

  @@map("cuentas_bancarias")
}

// Cheque — propio emitido o de tercero recibido
model Cheque {
  id             Int      @id @default(autoincrement())
  tipo           String   @db.VarChar(10) // "propio" | "tercero"
  formato        String   @default("fisico") @db.VarChar(10) // "fisico" | "echeq"
  numero         String   @db.VarChar(30)
  banco          String   @db.VarChar(60)
  monto          Decimal  @db.Decimal(14, 2)
  fechaEmision   DateTime @db.Date
  fechaCobro     DateTime @db.Date // fecha de cobro/vencimiento

  // Propios
  cuentaId       Int?
  cuenta         CuentaBancaria? @relation(fields: [cuentaId], references: [id])

  // Terceros
  librador       String?  @db.VarChar(100) // emisor (cliente)
  cuitLibrador   String?  @db.VarChar(15)
  clienteCod     String?  @db.VarChar(20) // PunTouch Cliente cod

  // Destino (si ya lo usaste): proveedor a quien se giro o endoso
  proveedorCod   String?  @db.VarChar(20)
  proveedorNombre String?  @db.VarChar(120)

  // Estado
  estado         String   @db.VarChar(20) // "en-cartera" | "en-circulacion" | "pagado" | "depositado" | "rechazado" | "anulado"
  fechaEstado    DateTime @default(now()) // fecha del ultimo cambio de estado

  observaciones  String?  @db.Text
  usuario        String?  @db.VarChar(60) // quien lo cargo

  // Reemplazo: cuando un cheque se canjea por otro
  reemplazaId    Int?     @unique  // este cheque reemplaza a otro (el viejo)
  reemplaza      Cheque?  @relation("ChequeReemplazo", fields: [reemplazaId], references: [id])
  reemplazadoPor Cheque?  @relation("ChequeReemplazo")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipo])
  @@index([estado])
  @@index([fechaCobro])
  @@index([proveedorCod])
  @@index([clienteCod])
  @@map("cheques")
}

model ProductoProveedor {
  id            Int      @id @default(autoincrement())
  sku           String   @db.VarChar(7)
  productName   String   @default("") @db.VarChar(60)
  proveedorCod  String   @db.VarChar(7)
  proveedorName String   @db.VarChar(60)
  createdAt     DateTime @default(now())

  @@unique([sku, proveedorCod])
  @@index([proveedorCod])
  @@index([sku])
  @@map("producto_proveedor")
}

// POS Web terminal configuration
model PosTerminal {
  id              Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(60)
  sucursal        String   @db.VarChar(10)
  sucursalNombre  String   @db.VarChar(60)
  listas          String   @db.VarChar(30)  // comma-separated list numbers: "1" or "2,3,4"
  cuit            String   @db.VarChar(20)
  razonSocial     String   @db.VarChar(120)
  direccion       String   @db.VarChar(200)
  aliasBanco      String   @db.VarChar(60)  @default("")
  formatoImpresion String  @db.VarChar(10)  // "ticket" or "a4"
  flujo           String   @db.VarChar(10)  // "directo" or "pendiente"
  permisoAnular   Boolean  @default(false)
  permisoPrecio   Boolean  @default(false)
  permisoDevolver Boolean  @default(true)
  requiereCliente Boolean  @default(false)
  esCajero        Boolean  @default(false)  // true = shows pending orders list instead of product search
  modoPrueba      Boolean  @default(false)  // true = sales NOT written to PunTouch (training mode)
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pos_terminales")
}

// WhatsApp broadcast campaigns
model Difusion {
  id          Int       @id @default(autoincrement())
  mensaje     String    @db.Text
  imagenUrl   String?   @db.VarChar(500)
  filtro      String    @db.VarChar(30)  // "todos" | "zona:LUNES" | "reparto" etc.
  programada  DateTime?                  // null = send immediately
  estado      String    @default("pendiente") @db.VarChar(20) // pendiente | enviando | completada | cancelada
  enviados    Int       @default(0)
  fallidos    Int       @default(0)
  total       Int       @default(0)
  creadoPor   String    @db.VarChar(60)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients DifusionRecipient[]

  @@index([estado])
  @@index([programada])
  @@map("difusiones")
}

model DifusionRecipient {
  id          Int      @id @default(autoincrement())
  difusionId  Int
  clientId    String   @db.VarChar(10)
  nombre      String   @db.VarChar(120)
  telefono    String   @db.VarChar(30)
  estado      String   @default("pendiente") @db.VarChar(20) // pendiente | enviado | fallido | dedup
  error       String?  @db.VarChar(200)
  sentAt      DateTime?
  difusion    Difusion @relation(fields: [difusionId], references: [id], onDelete: Cascade)

  @@index([difusionId, estado])
  @@map("difusion_recipients")
}
